<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Abijit Malakar | Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #080808;
            color: #ffffff;
            line-height: 1.6;
        }

        /* NAVBAR */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(8, 8, 8, 0.9);
            backdrop-filter: blur(10px);
            z-index: 1000;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
        }

        .logo span {
            color: #00e5ff;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        nav ul li a:hover {
            color: #00e5ff;
        }

        /* HERO */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 100px 8% 50px;
        }

        .hero-content {
            max-width: 750px;
        }

        .hero h3 {
            color: #00e5ff;
            font-size: 22px;
            margin-bottom: 10px;
        }

        .hero h1 {
            font-size: clamp(45px, 8vw, 85px);
            line-height: 1;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #00e5ff;
        }

        .hero p {
            color: #bdbdbd;
            font-size: 18px;
            max-width: 650px;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 13px 25px;
            border: 1px solid #00e5ff;
            color: #00e5ff;
            text-decoration: none;
            border-radius: 30px;
            transition: 0.3s;
        }

        .btn:hover {
            background: #00e5ff;
            color: #000;
        }

        /* SECTIONS */
        section {
            padding: 100px 8%;
        }

        .section-title {
            font-size: 40px;
            margin-bottom: 45px;
        }

        .section-title span {
            color: #00e5ff;
        }

        /* ABOUT */
        .about {
            max-width: 850px;
        }

        .about p {
            color: #bdbdbd;
            font-size: 18px;
        }

        /* SKILLS */
        .skills {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
        }

        .skill {
            padding: 25px;
            border: 1px solid #222;
            border-radius: 15px;
            background: #101010;
            transition: 0.3s;
        }

        .skill:hover {
            transform: translateY(-5px);
            border-color: #00e5ff;
        }

        .skill h3 {
            color: #00e5ff;
            margin-bottom: 8px;
        }

        .skill p {
            color: #aaa;
        }

        /* PROJECTS */
        .projects {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        .project {
            background: #101010;
            border: 1px solid #222;
            border-radius: 18px;
            padding: 30px;
            transition: 0.3s;
        }

        .project:hover {
            transform: translateY(-8px);
            border-color: #00e5ff;
        }

        .project-number {
            color: #00e5ff;
            font-size: 14px;
        }

        .project h3 {
            margin: 15px 0;
            font-size: 24px;
        }

        .project p {
            color: #aaa;
        }

        /* CONTACT */
        .contact-box {
            max-width: 650px;
            background: #101010;
            border: 1px solid #222;
            padding: 35px;
            border-radius: 20px;
        }

        .contact-box p {
            margin: 15px 0;
            color: #bbb;
        }

        .contact-box a {
            color: #00e5ff;
            text-decoration: none;
        }

        /* FOOTER */
        footer {
            text-align: center;
            padding: 30px;
            border-top: 1px solid #222;
            color: #777;
        }

        /* MOBILE */
        @media (max-width: 700px) {

            nav {
                padding: 18px 5%;
            }

            nav ul {
                gap: 12px;
                font-size: 13px;
            }

            .hero {
                padding-left: 5%;
                padding-right: 5%;
            }

            section {
                padding: 80px 5%;
            }

            .hero h1 {
                font-size: 50px;
            }
        }
    </style>
</head>

